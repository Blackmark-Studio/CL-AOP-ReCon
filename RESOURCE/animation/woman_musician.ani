; Анимации для скрипачек и флейтисток

animation = woman_musician.an

data = "Turn speed", "5.5"

;===========================================================================
;======================================================== МИРНЫЕ АНИМАЦИИ 
;===========================================================================


;Игра на скрипке
[idle_1]
	speed = 1.7
	loop = true
	type = normal
	start_time = 1
	end_time = 201
	data = "Blend time", "0.2"		; sec
	data = "Probability", "1.0"

;Игра на флейте
[flute_idle_1]
	speed = 1.7
	loop = true
	type = normal
	start_time = 314
	end_time = 514
	data = "Blend time", "0.2"		; sec
	data = "Probability", "1.0"
	
; заглушка на инру на флейте сидя
[flute_idle_sit_1]
	speed = 1.7
	loop = true
	type = normal
	start_time = 314
	end_time = 514
	data = "Blend time", "0.2"		; sec
	data = "Probability", "1.0"

;СМЕРТЬ
